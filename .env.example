# =============================================================================
# SGVA-Matchmaker — variables de entorno
# Copia este archivo como `.env` y complétalo. `.env` está en .gitignore:
# NUNCA lo subas a GitHub ni lo compartas.
# =============================================================================

# --- Credenciales del SGVA (Caprendizaje) ------------------------------------
# Solo se usan en tu equipo para iniciar sesión en el portal del SENA. No se envían
# a ningún otro servidor ni a la API del LLM. Puedes dejarlas vacías y hacer el login
# manualmente la primera vez: la sesión quedará guardada en session.json.
SENA_USER=            # número de documento (cédula / TI)
SENA_PASSWORD=

# URL de inicio de sesión del portal
SGVA_LOGIN_URL=https://caprendizaje.sena.edu.co/sgva/
# URL directa de la tabla de convocatorias (recomendado). Obténla con `python main.py --calibrar`.
# Si se deja vacía, se navega por el menú con los pasos de config/selectors.json.
SGVA_VACANTES_URL=

# --- Área de búsqueda ----------------------------------------------------------
PROGRAMA_FORMACION=Análisis y Desarrollo de Software
# Palabras clave (separadas por coma) para filtrar vacantes de tu área
PALABRAS_CLAVE_AREA=ADSO,software,desarrollo,programación,sistemas,desarrollador
MAX_PAGINAS=20

# --- Navegador y scraping ético -----------------------------------------------
HEADLESS=true         # false = ver el navegador
# Navegador: vacío = Chromium de Playwright · msedge · chrome (el .exe usa msedge por defecto)
BROWSER_CHANNEL=
DELAY_MIN=2           # segundos mínimos entre acciones
DELAY_MAX=5           # segundos máximos entre acciones
MAX_REINTENTOS=3
TIMEOUT_MS=30000

# --- LLM (correos y fichas de empresa) -------------------------------------------
# gemini | openai. Si no hay clave, se usan plantillas locales (todo sigue funcionando).
LLM_PROVIDER=gemini
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Telegram ----------------------------------------------------------------------
# 1) Crea un bot con @BotFather → token.  2) Escríbele al bot.
# 3) Abre https://api.telegram.org/bot<TOKEN>/getUpdates y copia "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITOR_INTERVALO_MIN=180   # cada cuánto revisa el portal en modo --monitor (mín. sugerido: 60)

# --- Enriquecimiento ---------------------------------------------------------------
ENRICH_MAX_RESULTADOS=6
